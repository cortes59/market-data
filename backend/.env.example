# =============================================
# 🚀 Backend Configuration (NestJS)
# =============================================
# Copy this file to .env: cp .env.example .env

# =============================================
# 🗄️ Database
# =============================================
# PostgreSQL connection string
DATABASE_URL=postgres://market_user:market_pass@localhost:5432/market_data

# =============================================
# 🌐 Server
# =============================================
# Backend server port
BACKEND_PORT=3000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Environment mode
NODE_ENV=development

# =============================================
# 📊 CoinGecko API (Optional - has defaults)
# =============================================
# CoinGecko API base URL
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# =============================================
# 🔌 Circuit Breaker (Optional - has defaults)
# =============================================
# Number of consecutive failures before circuit opens
CIRCUIT_BREAKER_THRESHOLD=5

# Time in ms before attempting to close circuit
CIRCUIT_BREAKER_RESET_MS=30000
